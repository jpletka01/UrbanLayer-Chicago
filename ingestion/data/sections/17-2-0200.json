{
  "section": "17-2-0200",
  "section_title": "Allowed uses",
  "title_number": 17,
  "title_name": "CHICAGO ZONING ORDINANCE",
  "chapter": "17-2",
  "chapter_name": "RESIDENTIAL DISTRICTS",
  "article": null,
