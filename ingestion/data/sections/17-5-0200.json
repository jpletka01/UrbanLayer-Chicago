{
  "section": "17-5-0200",
  "section_title": "Allowed uses",
  "title_number": 17,
  "title_name": "CHICAGO ZONING ORDINANCE",
  "chapter": "17-5",
  "chapter_name": "MANUFACTURING DISTRICTS",
