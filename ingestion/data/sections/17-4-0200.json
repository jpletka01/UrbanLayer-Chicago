{
  "section": "17-4-0200",
  "section_title": "Allowed uses",
  "title_number": 17,
  "title_name": "CHICAGO ZONING ORDINANCE",
  "chapter": "17-4",
  "chapter_name": "DOWNTOWN DISTRICTS",
  "article": null,
  "article_name": "",
  "subarticle": null,
