# Copy to frontend/.env for `npm run dev`.

# Mapbox GL public token (account.mapbox.com/access-tokens). Without it the pages
# work but maps have no tiles.
VITE_MAPBOX_TOKEN=

# Backend base URL. Leave empty when served behind nginx (the Docker/prod build).
VITE_API_BASE=http://localhost:8001

# Optional monitoring; both are off when empty.
VITE_SENTRY_DSN=
VITE_CLARITY_ID=
