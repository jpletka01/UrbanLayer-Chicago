# Copy to .env. Everything is optional except where noted; the Property Profile
# works with this file unchanged (it only reads public open-data APIs).
# Comments must be on their own line: an inline "# ..." after a value becomes
# part of the value.

# --- Core ---
# Required for chat and the PDF report's AI sections (console.anthropic.com).
ANTHROPIC_API_KEY=
QDRANT_URL=http://localhost:6333
# Optional app tokens; without them the city/county Socrata APIs throttle sooner.
SOCRATA_APP_TOKEN=
COOK_COUNTY_SOCRATA_TOKEN=
# Optional (walkscore.com, 5,000 calls/day). Without it walk/transit scores are omitted.
WALKSCORE_API_KEY=

# --- Environment ---
# "production" makes startup refuse to run with any of the auth/payment settings
# below missing or weak (see backend/config.py: production_config_errors).
ENVIRONMENT=development

# --- Auth (disabled when GOOGLE_CLIENT_ID is empty; local dev runs as an admin user) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters in production: openssl rand -hex 32
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Payments (Stripe; checkout is unavailable when empty) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_REPORT=
STRIPE_PRICE_ID_PRO_MONTHLY=

# --- Operations ---
SENTRY_DSN=
# Global daily LLM spend cap; chat returns 503 for the rest of the day once reached.
DAILY_API_BUDGET_USD=5.00
# Anonymous chat limits per IP.
RATE_LIMIT_ANON_DAY=3
RATE_LIMIT_ANON_HOUR=3
# Tax figures need the 9.4 GB ptaxsim.db (python scripts/download_ptaxsim.py).
PTAXSIM_ENABLED=true
# Cross-encoder reranker: off by default (too slow on small CPUs; see backend/config.py).
RERANKER_ENABLED=false
# Second address-to-PIN source (on in production).
ASSESSOR_ADDRESS_RESOLUTION_ENABLED=true

# --- Docker frontend build ---
# docker compose passes this to the frontend image build. For `npm run dev`, set it
# in frontend/.env instead. Without it the page works but maps have no tiles.
VITE_MAPBOX_TOKEN=
# Host port for the Docker frontend (change if :80 is taken).
FRONTEND_PORT=80
