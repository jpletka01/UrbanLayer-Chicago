[Unit]
Description=Daily City Clerk legislation sync (passed-law currency and pending zoning)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/urbanlayer
# A SEPARATE ephemeral container (`run --rm`, `--no-deps`: no qdrant), like the Discovery
# rebuild. It writes backend/data/legislation_snapshot.json and pending_legislation.db on the
# shared backend_data volume. Both replace current data atomically and retain last-good rows on
# failure; the pending artifact stays dark until WS2 PR 2. Exit 1 = source/store failure, 2 =
# contract drift; both report to Sentry and leave the unit "failed".
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml run --rm --no-deps backend python -m backend.legislation.sync
# Gentle client: serial pages/details, page pauses, 3 tries each. The first pending refresh
# backfills full detail; later daily runs currently re-check it all. Allow for many requests.
TimeoutStartSec=1800
